<Page x:Class="KnowMySystem.HardwareSpecificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KnowMySystem"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HardwareSpecificationsPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.5*"/>
            <ColumnDefinition Width="6.5*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Image HorizontalAlignment="Center" Height="205" VerticalAlignment="Top" Width="235" Source="/Images/PC icon.png" Grid.Column="0"/>
            <Label x:Name="compName" Content="SATYANUTELLA-PC" FontSize="22" Width="260" HorizontalContentAlignment="Center" Style="{DynamicResource SegoeUIVariable}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Grid.Column="0"/>
            <Label x:Name="renamePCButton" Content="Rename this PC" HorizontalContentAlignment="Center" FontSize="20" Foreground="#FF2B78D4" Cursor="Hand" MouseDown="renamePCButton_MouseDown" Width="260" Style="{DynamicResource SegoeUIVariable}" Grid.Column="0"/>
        </StackPanel>
        <!--Right column-->
        <StackPanel Grid.Column="1">
            <Label Content="Your rig" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" FontSize="30" FontWeight="Bold" Style="{DynamicResource SegoeUIVariable}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Label x:Name="cpu" Content="CPU: AMD Ryzen 9 5950X 16-Core Processor" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Style="{DynamicResource SegoeUIVariable}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Label x:Name="gpu" Content="GPU: NVIDIA GeForce RTX 3090" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Style="{DynamicResource SegoeUIVariable}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Label x:Name="ram" Content="RAM: 32GB 3200MT/s DDR4" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Style="{DynamicResource SegoeUIVariable}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Label x:Name="motherboard" Content="Motherboard: LEGIT MOBOS X570 AM4" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Style="{DynamicResource SegoeUIVariable}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Label x:Name="storage" Content="Storage on Windows drive: 2TB" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Style="{DynamicResource SegoeUIVariable}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Label x:Name="cpuArchitecture" Content="CPU Architecture: 64-bit" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Style="{DynamicResource SegoeUIVariable}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Label x:Name="biosMode" Content="BIOS Mode: UEFI" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Style="{DynamicResource SegoeUIVariable}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Label x:Name="secureBoot" Content="Secure Boot: Enabled" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Style="{DynamicResource SegoeUIVariable}" Width="501" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Label x:Name="tpm" Content="TPM: TPM 2.0, Present and Enabled" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Style="{DynamicResource SegoeUIVariable}" Width="500" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </StackPanel>
    </Grid>
</Page>
